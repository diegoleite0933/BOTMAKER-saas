generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// SAAS - Admin / Proprietário
// ==========================================

model User {
  id        String    @id @default(cuid())
  name      String?
  nickname  String?
  email     String?   @unique
  password  String?   // Bcrypt hash
  cpf       String?
  revenueGoal Float?
  isBanned  Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  workspaces Workspace[]
  paymentIntegrations PaymentIntegration[]
  syncpayConnections SyncPayConnection[]
  oauthStates OAuthState[]

  @@index([nickname])
  @@index([cpf])
}

model PaymentIntegration {
  id                   String   @id @default(cuid())
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider             String
  encryptedCredentials String
  lastTestAt           DateTime?
  lastTestStatus       String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([userId, provider])
  @@index([provider])
}

model SyncPayConnection {
  id                    String    @id @default(cuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId            String
  workspace             Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  clientId              String
  encryptedClientSecret String
  accessToken           String?
  accessTokenExpiresAt  DateTime?
  webhookUrl            String?
  status                String    @default("disconnected")
  lastValidatedAt       DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([userId, workspaceId])
  @@index([workspaceId, status])
}

model OAuthState {
  id          String    @id @default(cuid())
  stateHash   String    @unique
  provider    String
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([provider, expiresAt])
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bots      Bot[]
  syncpayConnections SyncPayConnection[]
  oauthStates OAuthState[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==========================================
// BOTS E CONFIGURAÇÕES
// ==========================================

model Bot {
  id          String   @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  username    String?
  token       String   @unique
  status      String   @default("inactive") // active, inactive, testing
  webhookUrl  String?
  
  // Opções de Pagamento
  paymentMethod        String  @default("mercadopago") // mercadopago, pix_direto, amplopay, syncpay
  mpAccessToken        String? // Caso seja mercado pago
  pixKey               String? // Caso seja pix direto
  amploPayClientId     String? // Caso seja amplo pay
  amploPayClientSecret String? // Caso seja amplo pay
  pixReviewChatId      String?

  // Personalização
  welcomeMessage  String?
  welcomeMediaId  String? // file_id do Telegram
  welcomeMediaType String? // 'photo' ou 'video'
  storageChatId   String? // ID do canal/grupo de armazenamento de mídias
  welcomeMedia    WelcomeMedia[]
  
  products    Product[]
  orders      Order[]
  customers   TelegramUser[]
  remarketings Remarketing[]
  remarketingSends RemarketingSend[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ==========================================
// PRODUTOS E ENTREGÁVEIS
// ==========================================

model Product {
  id                 String    @id @default(cuid())
  botId              String
  bot                Bot       @relation(fields: [botId], references: [id], onDelete: Cascade)
  name               String
  description        String?
  price              Float
  discountPercent    Int       @default(0)
  billingType        String    @default("one_time") // one_time, recurring
  recurringInterval  String?   // monthly, quarterly, yearly
  currency           String    @default("BRL")
  status             String    @default("active") // active, inactive
  isOrderBumpOnly    Boolean   @default(false)
  orderBumpProductId String?
  orderBumpProduct   Product?  @relation("ProductOrderBump", fields: [orderBumpProductId], references: [id], onDelete: SetNull)
  offeredAsOrderBump Product[] @relation("ProductOrderBump")
  telegramMediaId    String?
  telegramMediaType  String?
  
  deliveries  ProductDelivery[]
  orders      Order[] @relation("BaseOrderProduct")
  bumpOrders  Order[] @relation("BumpOrderProduct")
  remarketingDiscounts Remarketing[] @relation("RemarketingDiscountProduct")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ProductDelivery {
  id             String   @id @default(cuid())
  productId      String
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  type           String   // ENUM: 'group', 'channel', 'file', 'text'
  telegramChatId String?  // ID do grupo/canal no telegram (se type = group/channel)
  content        String?  // URL do arquivo ou texto da mensagem
  durationDays   Int?     // Null = vitalício, 30 = 30 dias
}

// ==========================================
// CLIENTES FINAIS (TELEGRAM)
// ==========================================

model TelegramUser {
  id          String   // ID do Telegram (não auto-increment)
  botId       String
  bot         Bot      @relation(fields: [botId], references: [id], onDelete: Cascade)
  firstName   String?
  lastName    String?
  username    String?
  lastStartedAt DateTime?
  
  orders      Order[]
  accesses    Access[]
  remarketingSends RemarketingSend[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@id([id, botId]) // O mesmo cliente pode existir em bots diferentes
}

// ==========================================
// VENDAS (PIX MERCADO PAGO)
// ==========================================

model Order {
  id             String       @id @default(cuid())
  botId          String
  bot            Bot          @relation(fields: [botId], references: [id], onDelete: Cascade)
  productId      String
  product        Product      @relation("BaseOrderProduct", fields: [productId], references: [id], onDelete: Restrict)
  bumpProductId  String?
  bumpProduct    Product?     @relation("BumpOrderProduct", fields: [bumpProductId], references: [id], onDelete: SetNull)
  discountPercent Int          @default(0)
  telegramUserId String
  telegramUser   TelegramUser @relation(fields: [telegramUserId, botId], references: [id, botId], onDelete: Restrict)
  
  status         String       @default("pending") // pending, paid, failed, cancelled, refunded
  amount         Float
  bumpDiscountPercent Int     @default(0)
  currency       String       @default("BRL")
  
  paymentGateway String       @default("mercadopago")
  billingType    String       @default("one_time") // one_time, recurring
  recurringInterval String?    // monthly, quarterly, yearly
  paymentId      String?      @unique // ID gerado pelo Mercado Pago
  webhookSignature String?
  paymentQrCode  String?
  paymentTicketUrl String?
  receiptUrl     String?      // Imagem do comprovante enviado (caso pix_direto)
  
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model PlatformReceivingAccount {
  id                    String   @id @default(cuid())
  provider              String   @unique
  encryptedCredentials  String?
  status                String   @default("NOT_CONFIGURED")
  lastValidatedAt       DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

// ==========================================
// CONTROLE DE ACESSO
// ==========================================

model Access {
  id             String       @id @default(cuid())
  telegramUserId String
  botId          String
  telegramUser   TelegramUser @relation(fields: [telegramUserId, botId], references: [id, botId], onDelete: Cascade)
  
  deliveryId     String
  
  status         String       @default("active") // active, expired, revoked
  inviteLink     String?      // Link único gerado para o usuário
  
  expiresAt      DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

// ==========================================
// IDEMPOTÊNCIA E WEBHOOKS
// ==========================================

model WebhookEvent {
  id          String   @id @default(cuid())
  source      String   // 'telegram' ou 'mercadopago'
  eventId     String   // ID do update do telegram ou ID do evento do mercado pago
  payload     String
  status      String   @default("pending") // pending, processed, failed
  error       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([source, eventId]) // Garante que um evento não seja processado 2x
}

model Remarketing {
  id          String   @id @default(cuid())
  botId       String
  bot         Bot      @relation(fields: [botId], references: [id], onDelete: Cascade)
  name        String
  delayDays   Int?
  delayMinutes Int @default(60)
  targetProductId String?
  targetProduct Product? @relation("RemarketingDiscountProduct", fields: [targetProductId], references: [id], onDelete: SetNull)
  discountPercent Int @default(0)
  message     String?
  mediaFileId String?
  mediaType   String?
  isActive    Boolean  @default(false)
  sends       RemarketingSend[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([botId, isActive])
}

model RemarketingSend {
  id             String       @id @default(cuid())
  remarketingId  String
  remarketing    Remarketing  @relation(fields: [remarketingId], references: [id], onDelete: Cascade)
  botId          String
  bot            Bot          @relation(fields: [botId], references: [id], onDelete: Cascade)
  telegramUserId String
  telegramUser   TelegramUser @relation(fields: [telegramUserId, botId], references: [id, botId], onDelete: Cascade)
  status         String       @default("sending")
  failureReason  String?
  sentAt         DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([remarketingId, telegramUserId])
  @@index([botId, status])
}

model WelcomeMedia {
  id        String   @id @default(cuid())
  botId     String
  bot       Bot      @relation(fields: [botId], references: [id], onDelete: Cascade)
  fileId    String
  mediaType String
  position  Int
  createdAt DateTime @default(now())

  @@unique([botId, position])
  @@index([botId, position])
}
