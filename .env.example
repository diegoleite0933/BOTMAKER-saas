# Ambiente
NODE_ENV=development
APP_URL=http://localhost:3000

# Banco de Dados (Local via Docker)
DATABASE_URL="postgresql://root:rootpassword@localhost:5432/botmaker?schema=public"

# Redis (Fila e Cache)
REDIS_URL="redis://localhost:6379"

# Autenticação (NextAuth)
# Gere um secret seguro rodando: openssl rand -base64 32
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=http://localhost:3000

# Telegram
# (Recomendado colocar o token apenas no .env, não no código)
TELEGRAM_BOT_TOKEN="8638834797:AAFbfDhL3Jw_KqM1oymK3hn99CKtrMai3TU"
TELEGRAM_WEBHOOK_SECRET="um_segredo_aleatorio_para_o_webhook"

# Pagamentos (PIX)
# Como você solicitou PIX, usaremos o Mercado Pago como gateway padrão.
MERCADOPAGO_ACCESS_TOKEN="seu_access_token_aqui"
MERCADOPAGO_WEBHOOK_SECRET="seu_webhook_secret_aqui"

# Storage
STORAGE_PROVIDER="local"
STORAGE_LOCAL_PATH="./public/uploads"
