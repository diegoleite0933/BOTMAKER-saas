# Ambiente
NODE_ENV=production
APP_URL=https://botmaker-web-iu2a.onrender.com
NEXTAUTH_URL=https://botmaker-web-iu2a.onrender.com

# Banco de Dados
# Exemplo local com Docker: postgresql://root:rootpassword@localhost:5432/botmaker?schema=public
DATABASE_URL="postgresql://root:rootpassword@localhost:5432/botmaker?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# Autenticação NextAuth
NEXTAUTH_SECRET=replace_with_a_secure_random_secret
PAYMENT_CREDENTIALS_ENCRYPTION_KEY=replace_with_a_secure_random_key

# Telegram
TELEGRAM_BOT_TOKEN="your_telegram_bot_token"
TELEGRAM_WEBHOOK_SECRET="replace_with_a_random_webhook_secret"

# Pagamentos
MERCADOPAGO_ACCESS_TOKEN="your_mercadopago_access_token"
MERCADOPAGO_WEBHOOK_SECRET="your_mercadopago_webhook_secret"
AMPLOPAY_CLIENT_ID="your_amplopay_client_id"
AMPLOPAY_CLIENT_SECRET="your_amplopay_client_secret"
SYNC_PAY_CLIENT_ID="your_syncpay_client_id"
SYNC_PAY_CLIENT_SECRET="your_syncpay_client_secret"
SYNCPAY_CLIENT_ID="your_syncpay_client_id"
SYNCPAY_CLIENT_SECRET="your_syncpay_client_secret"

# E-mail / SMTP (opcional)
EMAIL_USER="your_email@example.com"
EMAIL_PASS="your_email_app_password"

# Storage
STORAGE_PROVIDER="local"
STORAGE_LOCAL_PATH="./public/uploads"
